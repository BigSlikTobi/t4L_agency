OPENAI_API_KEY=sk-...
SUPABASE_NEWS_FEED_URL=https://your-project.supabase.co/functions/v1/news_entities_feed
SUPABASE_ARTICLE_LOOKUP_URL=https://your-project.supabase.co/functions/v1/article-content-lookup
SUPABASE_STORY_GROUP_UPDATES_URL=https://your-project.supabase.co/functions/v1/story-group-updates
SUPABASE_FUNCTION_AUTH_TOKEN=your-supabase-function-token
TEAM_UPDATE_HISTORY_SQLITE_PATH=./var/team_update_history.sqlite3
# Per-agent model overrides.
OPENAI_MODEL_ARTICLE_DATA_AGENT=gpt-5-mini
OPENAI_MODEL_TEAM_NEWS_AGENT=gpt-5-mini
OPENAI_MODEL_RUNDOWN_ORCHESTRATOR_AGENT=gpt-5.1
OPENAI_MODEL_TEAM_UPDATE_AGENT=gpt-5.1
OPENAI_MODEL_TEAM_UPDATE_BATCH_AGENT=gpt-5.1
OPENAI_MODEL_HOURLY_PLAYLIST_ORCHESTRATOR_AGENT=gpt-5.1
OPENAI_MODEL_RADIO_SCRIPT_WRITER_AGENT=gpt-5.1
OPENAI_MODEL_HOURLY_SCRIPT_BATCH_AGENT=gpt-5.1
# Optional shared fallbacks for older configs.
OPENAI_MODEL_CHIEF_EDITOR=gpt-5.1
OPENAI_MODEL_TEAM_ANALYST=gpt-5-mini
OPENAI_MODEL_STORY_RESEARCHER=gpt-5-mini
OPENAI_TEMPERATURE=
OPENAI_MAX_TOKENS=
